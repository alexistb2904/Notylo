# Copy this file to .env on the VPS and replace every secret/domain value.
# Generate secrets with e.g. `openssl rand -hex 48`.

POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret

MINIO_ACCESS_KEY=notylo
MINIO_SECRET_KEY=replace-with-a-long-random-hex-secret
MINIO_BUCKET=notylo-assets

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Keep true only while creating the accounts you need, then switch to false.
REGISTRATION_ENABLED=true

# Exact public HTTPS origin. No trailing slash.
CORS_ORIGIN=https://notes.example.com
WEBAUTHN_RP_ID=notes.example.com
WEBAUTHN_ORIGIN=https://notes.example.com

OCR_TEXT_WORKERS=3
OCR_MATH_WORKERS=1

# The web container is only exposed on loopback. Put Caddy/Nginx/Traefik in front.
WEB_PORT=8080
LOG_LEVEL=info

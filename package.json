{
  "name": "notylo-notes",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @notylo/web dev",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:api": "pnpm --filter @notylo/api dev",
    "build": "pnpm --filter=!@notylo/desktop -r --if-present build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "build:desktop:windows": "pnpm --dir apps/desktop build:windows",
    "build:desktop:linux": "pnpm --dir apps/desktop build:linux",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @notylo/web test:e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}

# Local development (host processes + Docker dependencies)
POSTGRES_PASSWORD=notylo
DATABASE_URL=postgresql://notylo:notylo@127.0.0.1:5433/notylo

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=notylo
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=notylo-assets

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
REGISTRATION_ENABLED=true


VITE_API_URL=http://localhost:3001
# Protect the web application behind the account login. Set false for a public local app.
VITE_REQUIRE_AUTH=true

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
DB_POOL_MAX=10

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notylo",
  "version": "1.0.0",
  "identifier": "com.alexistb.notylo",
  "build": {
    "beforeDevCommand": "node scripts/web.mjs dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/web.mjs build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notylo",
        "url": "notylo-1.0.0.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "img-src": "'self' asset: https: http://localhost:* http://127.0.0.1:* data: blob:",
        "media-src": "'self' https: http://localhost:* http://127.0.0.1:* data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "script-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:",
        "img-src": "'self' asset: http://localhost:* http://127.0.0.1:* https: data: blob:",
        "media-src": "'self' http://localhost:* http://127.0.0.1:* https: data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "script-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["notylo"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "A local-first notebook and whiteboard",
    "longDescription": "Notylo is a local-first notebook and whiteboard for writing, drawing and organising ideas.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
